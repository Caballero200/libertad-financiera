    <p>Contenido...</p>

    <h2>Sección 2</h2>
    <p>Contenido...</p>

    <h2>Sección 3</h2>
    <ul>
      <li>Punto 1</li>
      <li>Punto 2</li>
    </ul>

    <h2>Conclusión</h2>
    <p>Resumen final...</p>

    <p style="margin-top:20px;">
      <a href="index.html">← Volver al inicio</a>
    </p>

  </section>
</main>

<footer>
  <p>© 2025 Libertad Financiera</p>
</footer>

</body>
</html>
